# Production secrets: configure these in the hosting environment. Never commit real values.
# Generate each with a cryptographically secure random generator (32+ bytes).
JWT_SECRET="replace-with-at-least-32-random-characters"
SETUP_TOKEN="replace-with-a-different-long-random-secret"

# Optional. On persistent Node hosting this defaults to ./data.
DATA_DIR="./data"

# Optional existing integration.
GEMINI_API_KEY=""
APP_URL=""
